---
import type { CollectionEntry } from 'astro:content';

interface Props {
    entry: CollectionEntry<'now'>;
}

const { entry } = Astro.props;
const { lately, workingOn, into } = entry.data;
---

<section class="now-section">
    <span class="section-num">N° 01 — Lately</span>
    <div class="now-grid">
        {lately.map((card) => (
            <div class="now-card">
                <p class="card-label">{card.label}</p>
                <p class="card-body" set:html={card.body} />
            </div>
        ))}
    </div>
</section>

<section class="now-block">
    <span class="section-num">N° 02 — What I'm working on</span>
    <div class="block-body">
        {workingOn.map((para) => <p set:html={para} />)}
    </div>
</section>

<section class="now-block">
    <span class="section-num">N° 03 — What I'm into</span>
    <div class="block-body">
        {into.map((para) => <p set:html={para} />)}
    </div>
</section>

<style>
    .section-num {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1.25rem;
    }

    .now-section {
        margin-top: 3rem;
    }
    .now-section .section-num { margin-bottom: 1.5rem; }
    .now-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    @media (min-width: 700px) {
        .now-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
    }
    .now-card {
        border: 1px solid var(--rule);
        padding: 1.25rem 1.5rem;
        transition: border-color 0.2s ease;
    }
    .now-card:hover { border-color: rgba(230, 181, 74, 0.3); }
    .card-label {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin: 0 0 0.75rem;
    }
    .card-body {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--ink);
        line-height: 1.55;
        margin: 0;
    }
    .card-body :global(em) {
        font-family: var(--font-serif);
        font-style: italic;
        color: var(--gold);
        font-size: 1.05em;
    }

    .now-block {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid var(--rule);
    }
    .now-block .section-num { margin-bottom: 1.5rem; }
    .block-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        line-height: 1.65;
        color: var(--ink);
        max-width: 60ch;
    }
    .block-body :global(strong) { color: var(--ink); font-weight: 500; }
</style>
