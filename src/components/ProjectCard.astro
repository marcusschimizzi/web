---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    title: string;
    description: string;
    thumbnail: ImageMetadata;
    slug: string;
    featured?: boolean;
}

const { title, description, thumbnail, slug, featured = false } = Astro.props;
---

<a href={`/projects/${slug}`} class="project-card group">
    <div class="thumb">
        <Image
            src={thumbnail}
            alt={title}
            width={1280}
            height={720}
            class="thumb-img"
        />
        <div class="thumb-overlay"></div>
        {featured && (
            <span class="featured-tag" aria-label="Featured project">
                <span class="featured-dot"></span>
                Featured
            </span>
        )}
    </div>

    <div class="card-body">
        <h2 class="card-title">{title}</h2>
        <p class="card-desc">{description}</p>
        <span class="card-cta">
            <span>Read more</span>
            <span class="arr">→</span>
        </span>
    </div>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: var(--ink);
        border: 1px solid var(--rule);
        background: var(--paper-raised);
        overflow: hidden;
        transition: border-color 0.3s ease, transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .project-card:hover {
        border-color: rgba(230, 181, 74, 0.4);
        transform: translateY(-2px);
    }

    .thumb {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        position: relative;
    }
    .thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
        filter: saturate(0.9);
    }
    .project-card:hover .thumb-img {
        transform: scale(1.03);
        filter: saturate(1);
    }
    .thumb-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(5,5,5,0.4), transparent 50%);
        pointer-events: none;
    }

    .featured-tag {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5ch;
        padding: 0.3rem 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
        background: rgba(5, 5, 5, 0.7);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(230, 181, 74, 0.3);
    }
    .featured-dot {
        width: 6px; height: 6px;
        background: var(--gold);
        display: inline-block;
    }

    .card-body {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .card-title {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: 1.375rem;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--ink);
        margin: 0 0 0.6rem;
        transition: color 0.2s ease;
    }
    .project-card:hover .card-title { color: var(--gold); }
    .card-desc {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        line-height: 1.55;
        color: var(--ink-dim);
        margin: 0 0 1.25rem;
        flex: 1;
    }
    .card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-dim);
        transition: color 0.2s ease;
    }
    .project-card:hover .card-cta { color: var(--gold); }
    .card-cta .arr { transition: transform 0.3s ease; }
    .project-card:hover .card-cta .arr { transform: translateX(4px); }
</style>
