---
import { features } from '@/config';

const currentPath = Astro.url.pathname;
const navLinks = [
    { href: '/about', label: 'About' },
    { href: '/projects', label: 'Work' },
    { href: '/experience', label: 'Experience' },
    ...(features.blog ? [{ href: '/blog', label: 'Writing' }] : []),
    { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) =>
    href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<nav aria-label="Main navigation" class="site-nav">
    <div class="nav-inner">
        <a href="/" class="mark" aria-label="Marcus Schimizzi — Home">
            <img src="/images/logo.svg" alt="" class="mark-logo" width="22" height="22" aria-hidden="true" />
            <span>Marcus&nbsp;Schimizzi</span>
        </a>

        <div class="nav-links" role="navigation">
            {navLinks.map(link => (
                <a
                    href={link.href}
                    class:list={["nav-link", { active: isActive(link.href) }]}
                >
                    {link.label}
                </a>
            ))}
        </div>

        <div class="nav-meta">
            <span class="clock" aria-hidden="true">
                <span id="nav-clock">CHI</span>
            </span>
            <button
                id="menu-btn"
                type="button"
                class="menu-btn"
                aria-label="Toggle menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg class="icon-bars" width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
                    <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.4" />
                </svg>
                <svg class="icon-close" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" />
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="mobile-menu" hidden>
        <div class="mobile-menu-inner">
            {navLinks.map(link => (
                <a
                    href={link.href}
                    class:list={["mobile-link", { active: isActive(link.href) }]}
                >
                    {link.label}
                </a>
            ))}
        </div>
    </div>
</nav>

{/* Outside the nav: its backdrop-filter would otherwise become the scrim's
    containing block and clamp position:fixed to the nav's box. */}
<div id="menu-scrim" class="menu-scrim" hidden></div>

<style>
    .site-nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 50;
        background: linear-gradient(to bottom, var(--paper) 60%, rgba(5, 5, 5, 0.85) 90%, transparent);
        backdrop-filter: blur(6px);
    }

    .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.4rem clamp(1.25rem, 3vw, 3rem);
        max-width: 1440px;
        margin: 0 auto;
    }

    /* MARK */
    .mark {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: 0.875rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
    }
    .mark-logo {
        display: block;
        width: 22px;
        height: 22px;
        transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
    }
    .mark:hover .mark-logo { transform: rotate(-6deg); }

    /* DESKTOP LINKS */
    .nav-links {
        display: none;
        align-items: center;
        gap: 2.25rem;
    }
    @media (min-width: 800px) {
        .nav-links { display: flex; }
    }
    .nav-link {
        font-size: 0.8125rem;
        font-weight: 400;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        position: relative;
        padding: 0.25rem 0;
        transition: color 0.2s ease;
    }
    .nav-link::after {
        content: '';
        position: absolute;
        left: 0; right: 0;
        bottom: -2px;
        height: 1px;
        background: var(--gold);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .nav-link:hover::after,
    .nav-link.active::after { transform: scaleX(1); }
    .nav-link.active { color: var(--gold); }

    /* META (clock + hamburger) */
    .nav-meta {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }
    .clock {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        color: var(--ink-dim);
        font-variant-numeric: tabular-nums;
        display: none;
        align-items: center;
        gap: 0.6ch;
    }
    @media (min-width: 800px) {
        .clock { display: inline-flex; }
    }

    .menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: transparent;
        border: 1px solid var(--rule-strong);
        border-radius: 0;
        color: var(--ink);
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease;
    }
    .menu-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
    }
    .menu-btn .icon-close { display: none; }
    .menu-btn[aria-expanded="true"] .icon-bars { display: none; }
    .menu-btn[aria-expanded="true"] .icon-close { display: block; }
    @media (min-width: 800px) {
        .menu-btn { display: none; }
    }

    /* MOBILE MENU */
    .mobile-menu {
        position: relative;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule-strong);
        background: var(--paper);
    }
    .mobile-menu[hidden] { display: none; }
    /* Click-catcher only. Dimming happens via body.menu-open below — group
       opacity flattens composited (animated) children, which a translucent
       overlay can't reliably paint above. */
    .menu-scrim {
        position: fixed;
        inset: 0;
        z-index: 40; /* below .site-nav's 50, above everything else */
    }
    .menu-scrim[hidden] { display: none; }
    :global(body.menu-open main),
    :global(body.menu-open footer) {
        opacity: 0.25;
        transition: opacity 0.2s ease;
    }
    .mobile-menu-inner {
        display: flex;
        flex-direction: column;
        padding: 0.5rem clamp(1.25rem, 3vw, 3rem) 1.25rem;
    }
    .mobile-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 0;
        color: var(--ink);
        text-decoration: none;
        font-family: var(--font-sans);
        font-size: 1.25rem;
        font-weight: 400;
        letter-spacing: -0.01em;
        border-bottom: 1px solid var(--rule);
        transition: color 0.2s ease, padding-left 0.2s ease;
    }
    .mobile-link:last-child { border-bottom: none; }
    .mobile-link:hover,
    .mobile-link:active { color: var(--gold); }
    .mobile-link.active { color: var(--gold); }
</style>

<script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const scrim = document.getElementById('menu-scrim');

    function setMenu(open: boolean) {
        if (!menu || !scrim || !btn) return;
        menu.toggleAttribute('hidden', !open);
        scrim.toggleAttribute('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
    }

    btn?.addEventListener('click', () => {
        setMenu(menu?.hasAttribute('hidden') ?? false);
    });
    scrim?.addEventListener('click', () => setMenu(false));
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
    });
    document.addEventListener('astro:after-swap', () => setMenu(false));

    function tickClock() {
        const el = document.getElementById('nav-clock');
        if (!el) return;
        const t = new Date().toLocaleTimeString('en-US', {
            hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Chicago'
        });
        el.textContent = `CHI · ${t}`;
    }
    tickClock();
    setInterval(tickClock, 30_000);
</script>
