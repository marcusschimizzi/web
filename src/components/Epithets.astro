---
---

<div class="epithets" aria-hidden="true">
    <span class="ep-prefix">a.k.a.</span>
    <span class="ep-row ep-row-1">
        <span class="ep-track">
            <span class="ep-item">Software developer,</span>
            <span class="ep-item">Lifelong learner,</span>
            <span class="ep-item">Data viz buff,</span>
            <span class="ep-item">Tinkerer,</span>
        </span>
    </span>
    <span class="ep-row ep-row-2">
        <span class="ep-track">
            <span class="ep-item">travel enthusiast,</span>
            <span class="ep-item">amateur chef,</span>
            <span class="ep-item">big sports guy,</span>
        </span>
    </span>
    <span class="ep-row ep-row-3">
        <span class="ep-track">
            <span class="ep-item">and current Chicagoan.</span>
            <span class="ep-item">and Notre Dame alum.</span>
            <span class="ep-item">and over-caffeinated.</span>
            <span class="ep-item">and pub trivia champion.</span>
        </span>
    </span>
</div>

<style>
    .epithets {
        --ep-h: 1.6rem;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 0.55ch;
        row-gap: 0;
        margin-top: 1.5rem;
        font-family: var(--font-sans);
        font-size: clamp(1rem, 1.35vw, 1.15rem);
        font-weight: 400;
        letter-spacing: -0.005em;
        line-height: var(--ep-h);
        color: var(--ink);
        opacity: 0;
        animation: fadeIn 1s ease-out 0.9s forwards;
    }

    .ep-prefix {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin-right: 0.6rem;
        align-self: center;
        white-space: nowrap;
    }
    .ep-prefix::before {
        content: '';
        display: inline-block;
        width: 22px;
        height: 1px;
        background: var(--rule-strong);
        vertical-align: middle;
        margin-right: 0.8rem;
        transform: translateY(-1px);
    }

    .ep-row {
        display: inline-block;
        overflow: hidden;
        height: var(--ep-h);
        vertical-align: bottom;
    }
    .ep-track {
        display: flex;
        flex-direction: column;
    }
    .ep-item {
        display: block;
        height: var(--ep-h);
        line-height: var(--ep-h);
        flex-shrink: 0;
        white-space: nowrap;
    }

    /* Middle row = the personality gold beat */
    .ep-row-2 .ep-item {
        font-family: var(--font-serif);
        font-style: italic;
        color: var(--gold);
        font-size: 1.05em; /* Besley runs larger than the old serif; smaller bump */
        letter-spacing: 0;
        position: relative;
        top: 0.06em;
    }

    .ep-row-1 .ep-track {
        animation: rotate4 16s cubic-bezier(.45,.05,.55,.95) infinite;
    }
    .ep-row-2 .ep-track {
        animation: rotate3 12s cubic-bezier(.45,.05,.55,.95) infinite;
        animation-delay: 4s;
    }
    .ep-row-3 .ep-track {
        animation: rotate4 16s cubic-bezier(.45,.05,.55,.95) infinite;
        animation-delay: 8s;
    }

    @keyframes rotate4 {
        0%,    21% { transform: translateY(0); }
        25%,   46% { transform: translateY(calc(-1 * var(--ep-h))); }
        50%,   71% { transform: translateY(calc(-2 * var(--ep-h))); }
        75%,   96% { transform: translateY(calc(-3 * var(--ep-h))); }
        100%       { transform: translateY(0); }
    }
    @keyframes rotate3 {
        0%,    28%  { transform: translateY(0); }
        33.3%, 62%  { transform: translateY(calc(-1 * var(--ep-h))); }
        66.6%, 95%  { transform: translateY(calc(-2 * var(--ep-h))); }
        100%        { transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .ep-row-1 .ep-track,
        .ep-row-2 .ep-track,
        .ep-row-3 .ep-track {
            animation: none;
        }
    }
</style>
