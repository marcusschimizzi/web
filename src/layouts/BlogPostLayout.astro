---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageLayout from './PageLayout.astro';
import TagList from '@components/TagList.astro';
import TableOfContents from '@components/TableOfContents.astro';
import ReadingProgress from '@components/ReadingProgress.astro';

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    tags: string[];
    readingTime: string;
    heroImage?: string | ImageMetadata;
    headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, pubDate, tags, readingTime, heroImage, headings = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
});
const publishedTime = pubDate.toISOString();
---

<PageLayout
    title={title}
    description={description}
    image={typeof heroImage === 'string' ? heroImage : undefined}
    type="article"
    {publishedTime}
    {tags}
>
    <ReadingProgress />
    <article class="blog-article">
        {heroImage && (
            typeof heroImage === 'string' ? (
                <img src={heroImage} alt={title} class="hero-img" />
            ) : (
                <Image
                    src={heroImage}
                    alt={title}
                    width={1200}
                    height={600}
                    class="hero-img"
                />
            )
        )}

        <header class="article-header">
            <span class="section-num">Essay</span>
            <h1 class="article-title">{title}</h1>
            <div class="article-meta">
                <time>{formattedDate}</time>
                <span class="sep">·</span>
                <span class="read-time">{readingTime}</span>
            </div>
            <TagList tags={tags} />
        </header>

        <TableOfContents {headings} />

        <div class="prose prose-invert prose-lg max-w-none article-prose">
            <slot />
        </div>

        <footer class="article-footer">
            <span class="footer-label">Tagged</span>
            <TagList tags={tags} />
        </footer>
    </article>
</PageLayout>

<style>
    .blog-article {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 0 4rem;
    }
    .hero-img {
        width: 100%;
        aspect-ratio: 2 / 1;
        object-fit: cover;
        margin-bottom: 3rem;
        border: 1px solid var(--rule);
        filter: saturate(0.95);
    }
    .article-header {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--rule);
    }
    .section-num {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1.25rem;
    }
    .article-title {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(2rem, 4.5vw, 3.5rem);
        letter-spacing: -0.035em;
        line-height: 1.0;
        color: var(--ink);
        margin: 0 0 1.5rem;
    }
    .article-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-dim);
        margin-bottom: 1.25rem;
    }
    .article-meta .sep { color: var(--ink-faint); }
    .article-meta .read-time { color: var(--gold); }

    .article-prose {
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        line-height: 1.7;
    }

    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--rule);
    }
    .footer-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin-bottom: 1rem;
    }
</style>
