---
import PageLayout from '@layouts/PageLayout.astro';
import { features } from '@/config';
---

<PageLayout title="404 | Marcus Schimizzi" description="Page not found.">
    <div class="not-found">
        <div class="big">
            <span class="big-num">404</span>
            <span class="big-em">not <em>found.</em></span>
        </div>
        <p class="msg">
            The page you're looking for doesn't exist or has been moved. Let's get you back on track.
        </p>
        <a href="/" class="btn">Go home</a>

        <div class="quick">
            <p class="quick-label">Quick links</p>
            <div class="quick-links">
                <a href="/projects">Projects</a>
                {features.blog && (<a href="/blog">Writing</a>)}
                <a href="/about">About</a>
                <a href="/experience">Experience</a>
            </div>
        </div>
    </div>
</PageLayout>

<style>
    .not-found {
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
    }
    .big {
        display: flex;
        flex-direction: column;
        line-height: 0.9;
    }
    .big-num {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(5rem, 18vw, 14rem);
        letter-spacing: -0.045em;
        color: var(--ink-faint);
    }
    .big-em {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(2rem, 5vw, 4rem);
        letter-spacing: -0.025em;
        color: var(--ink);
        margin-top: 0.5rem;
    }
    .big-em em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        color: var(--gold);
    }
    .msg {
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        color: var(--ink-dim);
        max-width: 44ch;
        line-height: 1.55;
        margin: 0;
    }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        background: var(--gold);
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .btn:hover { background: var(--gold-warm); }

    .quick {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--rule);
        width: 100%;
    }
    .quick-label {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin: 0 0 1rem;
    }
    .quick-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }
    .quick-links a {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--gold);
        padding-bottom: 1px;
        transition: color 0.2s ease;
    }
    .quick-links a:hover { color: var(--gold); }
</style>
