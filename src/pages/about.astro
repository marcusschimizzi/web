---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import portraitImage from '../assets/images/portrait.jpg';
import { features } from '@/config';
---

<PageLayout title="About | Marcus Schimizzi" description="Hi there! My name is Marcus. I'm a software engineer at Qualia working to make real estate transactions easier and more efficient.">
    <div class="page about">
        <header class="page-header">
            <span class="section-num">N° · About</span>
            <h1 class="page-title">Who am I?</h1>
        </header>

        <!-- Intro: portrait + bio -->
        <section class="about-intro">
            <Image
                src={portraitImage}
                alt="Marcus Schimizzi"
                class="portrait"
            />
            <div class="bio">
                <p>Hi there! My name is Marcus.</p>
                <p>I'm currently employed as a software engineer at <strong>Qualia</strong> working to make real estate transactions easier and more efficient.</p>
                <p>Outside of building software, I love to spend time traveling, reading (mostly nonfiction and biographies), worrying too much about my favorite sports teams, and cooking.</p>
                <a href="/docs/resume.pdf" class="btn-primary">Download résumé →</a>
            </div>
        </section>

        <section class="about-block">
            <span class="section-num">N° 01 — What I do</span>
            <div class="block-body">
                <p>
                    At <strong>Qualia</strong>, I build systems that automate real estate title searches and exams on the Search &amp; Exam team — full-stack work spanning React, TypeScript, web scraping, and multi-agent orchestration.
                </p>
                <p>
                    Before Qualia, I spent nearly five years at <strong>Qualtrics</strong> on the Data Visualization team, shipping features for the XM Platform with React, TypeScript, D3, and Golang. I also interned at <strong>Ford</strong> building a gamified training app, and freelanced throughout college — building sites and small web apps for local businesses.
                </p>
            </div>
        </section>

        <section class="about-block">
            <span class="section-num">N° 02 — How I work</span>
            <div class="block-body">
                <p>
                    I care about fast page loads, clean interfaces, and code that's easy to come back to six months later. I'd rather ship something simple that works well than something clever that's hard to maintain.
                </p>
                <p>
                    Above all, I try to approach things with curiosity first. I find it's important not to assume I know everything about a particular project, codebase, or solution. With LLMs changing how we build software, I've leaned into <em>rapid experimentation</em> — what used to be "let's decide the right path up front" is now "I've tried three different approaches today and here's why this one wins." I think that shift is a sea change in software engineering, and I've tried to embrace it wholeheartedly.
                </p>
            </div>
        </section>

        <section class="about-block">
            <span class="section-num">N° 03 — Outside of work</span>
            <div class="block-body">
                <p>
                    I'm a <strong>Notre Dame</strong> alum (BSE in Computer Science, class of 2019) living in <strong>Chicago</strong>. During college I spent a semester studying abroad in London, which remains one of my favorite cities.
                </p>
                <p>
                    My heritage on my father's side is Italian, and that's my first love of cuisine — it's what I cook most often and what I'd seek out first when dining out. I've been lucky enough to spend time in Greece sailing the Mediterranean on a catamaran and a month living in Siracusa, Sicily, where the pizza and pasta were everything you'd hope for.
                </p>
                <p>
                    I read a mix of fiction and nonfiction — a few favorites are <em>Slaughterhouse-Five</em>, <em>Klara and the Sun</em>, and <em>Moonwalking with Einstein</em>. And I worry far too much about my beloved Pittsburgh teams — the <strong>Steelers</strong>, <strong>Penguins</strong>, and <strong>Pirates</strong>. I also picked up an allegiance to the <strong>Mariners</strong> during my five years in Seattle, and of course the <strong>Notre Dame Fighting Irish</strong>.
                </p>
            </div>
        </section>

        <section class="about-block">
            <p class="bridge">
                Check out more about what I'm up to <a href="/now">now</a> and the different things I like to <a href="/uses">use</a>.
            </p>
        </section>

        <!-- Cross-links -->
        <section class="cross-links">
            <a href="/projects" class="cross-link">
                <span class="cross-num">→ 01</span>
                <span class="cross-label">See what I've built</span>
                <span class="cross-sub">Projects</span>
            </a>
            {features.blog && (
                <a href="/blog" class="cross-link">
                    <span class="cross-num">→ 02</span>
                    <span class="cross-label">Read my thoughts</span>
                    <span class="cross-sub">Writing</span>
                </a>
            )}
            <a href="/experience" class="cross-link">
                <span class="cross-num">→ 03</span>
                <span class="cross-label">Where I've worked</span>
                <span class="cross-sub">Experience</span>
            </a>
        </section>
    </div>
</PageLayout>

<style>
    .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 0 4rem;
    }
    .page-header {
        padding-bottom: 3rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--rule);
    }
    .section-num {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1.25rem;
    }
    .page-title {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.035em;
        line-height: 0.95;
        color: var(--ink);
        margin: 0;
    }

    .about-intro {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-bottom: 5rem;
        align-items: start;
    }
    @media (min-width: 800px) {
        .about-intro { grid-template-columns: 1fr 2fr; gap: 3rem; }
    }
    .portrait {
        width: 100%;
        aspect-ratio: 1 / 1;
        max-width: 320px;
        object-fit: cover;
        border: 1px solid var(--rule-strong);
        filter: saturate(0.9);
    }
    .bio {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        line-height: 1.6;
        color: var(--ink);
    }
    .bio strong { color: var(--ink); font-weight: 500; }
    .btn-primary {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.75rem;
        padding: 0.875rem 1.5rem;
        background: var(--gold);
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .btn-primary:hover { background: var(--gold-warm); transform: translateY(-1px); }

    .about-block {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid var(--rule);
    }
    .about-block .section-num { margin-bottom: 1.5rem; }
    .block-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        line-height: 1.65;
        color: var(--ink);
        max-width: 60ch;
    }
    .block-body strong { color: var(--ink); font-weight: 500; }
    .block-body em {
        font-family: var(--font-serif);
        font-style: italic;
        color: var(--gold);
        font-size: 1.05em;
    }

    .bridge {
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        color: var(--ink-dim);
    }
    .bridge a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--gold);
        padding-bottom: 1px;
        transition: color 0.3s ease;
    }
    .bridge a:hover { color: var(--gold); }

    .cross-links {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid var(--rule);
    }
    @media (min-width: 700px) {
        .cross-links { grid-template-columns: repeat(3, 1fr); }
    }
    .cross-link {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 2rem 1.5rem;
        text-decoration: none;
        color: var(--ink);
        border: 1px solid var(--rule);
        transition: border-color 0.3s ease, transform 0.3s ease;
    }
    .cross-link:hover {
        border-color: var(--gold);
        transform: translateY(-2px);
    }
    .cross-num {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
    }
    .cross-label {
        font-family: var(--font-sans);
        font-size: 1.25rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        color: var(--ink);
        transition: color 0.2s ease;
    }
    .cross-link:hover .cross-label { color: var(--gold); }
    .cross-sub {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin-top: 0.5rem;
    }
</style>
