---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import NowEntry from '@components/NowEntry.astro';

const entries = (await getCollection('now')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [current, ...previous] = entries;

const monthYear = (d: Date) =>
    d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<PageLayout title="Now | Marcus Schimizzi" description="What I'm focused on right now.">
    <div class="page now">
        <header class="page-header">
            <span class="section-num">N° · Now</span>
            <h1 class="page-title">What I'm <em>up to.</em></h1>
            <p class="page-aside">Last updated: {monthYear(current.data.pubDate)}</p>
        </header>

        <p class="page-lead">
            This is a "now" page. If you have your own site, <a href="https://nownownow.com/about">you should make one too</a>.
        </p>

        <NowEntry entry={current} />

        {previous.length > 0 && (
            <section class="now-previously">
                <span class="section-num">N° · Previously</span>
                <ul class="prev-list">
                    {previous.map((e) => (
                        <li>
                            <a href={`/now/${e.id}`}>{monthYear(e.data.pubDate)}</a>
                        </li>
                    ))}
                </ul>
            </section>
        )}
    </div>
</PageLayout>

<style>
    .page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 0 4rem;
    }
    .page-header {
        padding-bottom: 3rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--rule);
    }
    .section-num {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1.25rem;
    }
    .page-title {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.035em;
        line-height: 0.95;
        color: var(--ink);
        margin: 0 0 1rem;
    }
    .page-title em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        color: var(--gold);
        letter-spacing: -0.015em;
    }
    .page-aside {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ink-dim);
        letter-spacing: 0.04em;
        margin: 0;
    }
    .page-lead {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        color: var(--ink-dim);
        line-height: 1.55;
        margin: 0 0 3rem;
    }
    .page-lead a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--gold);
        padding-bottom: 1px;
        transition: color 0.3s ease;
    }
    .page-lead a:hover { color: var(--gold); }

    .now-previously {
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid var(--rule);
    }
    .now-previously .section-num { margin-bottom: 1.25rem; }
    .prev-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .prev-list a {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 2px;
        transition: color 0.2s ease, border-color 0.2s ease;
    }
    .prev-list a:hover {
        color: var(--gold);
        border-bottom-color: var(--gold);
    }
</style>
