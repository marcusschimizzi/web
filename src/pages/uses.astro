---
import PageLayout from '@layouts/PageLayout.astro';

const sections = [
    {
        num: '01',
        title: 'Editor & Terminal',
        items: [
            { name: 'Cursor + Neovim', desc: 'I go back and forth between the two roughly equally. Cursor for larger projects and AI-assisted workflows, Neovim when I want speed and focus.' },
            { name: 'Ghostty', desc: 'GPU-accelerated terminal. Fast and stays out of the way.' },
            { name: 'zsh', desc: 'Nothing fancy, just zsh with a lightweight config.' },
            { name: 'Monaspace', desc: "GitHub's variable monospace font family. Clean and readable." },
        ],
    },
    {
        num: '02',
        title: 'Dev Tools',
        items: [
            { name: 'Arc', desc: 'Primary browser. The spaces and split views fit how I work.' },
            { name: 'HTTPie', desc: 'Clean HTTP client for the terminal. Easier to read than curl.' },
            { name: 'Git CLI', desc: 'No GUI, just the command line. Muscle memory at this point.' },
        ],
    },
    {
        num: '03',
        title: 'Hardware',
        items: [
            { name: 'M2 Max MacBook Pro', desc: 'Primary laptop. Also have a custom-built desktop for heavier workloads.' },
            { name: 'MSI 49" Curved Ultrawide', desc: 'One big screen beats two monitors for me.' },
            { name: 'ZSA Moonlander', desc: 'Split ergonomic keyboard. Took a while to get used to, but worth it.' },
            { name: 'Uplift Standing Desk', desc: 'Solid wood top, electric sit-stand. Spend most of the day standing.' },
        ],
    },
    {
        num: '04',
        title: 'Apps',
        items: [
            { name: 'Strata / Obsidian', desc: "Slowly migrating from Obsidian to Strata, a note-taking app I'm building with PARA structure, richer note types, and AI integration." },
            { name: 'Spotify', desc: 'Always on while working.' },
            { name: 'Aerospace / i3', desc: 'Tiling window manager on every machine. Aerospace on macOS, i3 on my Arch Linux desktop.' },
        ],
    },
    {
        num: '05',
        title: 'This Site',
        items: [
            { name: 'Astro 5', desc: 'Static site generator for fast, content-focused sites.' },
            { name: 'Tailwind CSS', desc: 'Utility-first CSS framework for rapid styling.' },
            { name: 'MDX', desc: 'Markdown with JSX for blog posts and content pages.' },
            { name: 'Netlify', desc: 'Hosting and deployment with continuous deployment from GitHub.' },
            { name: 'Fathom Analytics', desc: 'Simple, privacy-focused analytics (no cookies).' },
        ],
    },
];
---

<PageLayout title="Uses | Marcus Schimizzi" description="A list of the tools, hardware, and software I use daily as a software engineer.">
    <div class="page uses">
        <header class="page-header">
            <span class="section-num">N° · Uses</span>
            <h1 class="page-title">Tools of the <em>trade.</em></h1>
            <p class="page-lead">
                A running list of the tools, hardware, and software I use daily. Inspired by the <a href="https://uses.tech">uses.tech</a> convention.
            </p>
        </header>

        {sections.map((section) => (
            <section class="uses-section">
                <span class="section-num">N° {section.num} — {section.title}</span>
                <dl class="uses-list">
                    {section.items.map((item) => (
                        <div class="uses-item">
                            <dt>{item.name}</dt>
                            <dd>{item.desc}</dd>
                        </div>
                    ))}
                </dl>
            </section>
        ))}
    </div>
</PageLayout>

<style>
    .page {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 0 4rem;
    }
    .page-header {
        padding-bottom: 3rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--rule);
    }
    .section-num {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1.25rem;
    }
    .page-title {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.035em;
        line-height: 0.95;
        color: var(--ink);
        margin: 0 0 1.5rem;
    }
    .page-title em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        color: var(--gold);
        letter-spacing: -0.015em;
    }
    .page-lead {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        color: var(--ink-dim);
        max-width: 56ch;
        line-height: 1.55;
        margin: 0;
    }
    .page-lead a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--gold);
        padding-bottom: 1px;
        transition: color 0.3s ease;
    }
    .page-lead a:hover { color: var(--gold); }

    .uses-section {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid var(--rule);
    }
    .uses-section .section-num { margin-bottom: 1.75rem; }
    .uses-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin: 0;
    }
    .uses-item {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.25rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--rule);
    }
    .uses-item:last-child { border-bottom: none; padding-bottom: 0; }
    @media (min-width: 700px) {
        .uses-item { grid-template-columns: 1fr 2fr; gap: 1.5rem; }
    }
    .uses-item dt {
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 500;
        color: var(--ink);
        margin: 0;
    }
    .uses-item dd {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--ink-dim);
        line-height: 1.55;
        margin: 0;
    }
</style>
