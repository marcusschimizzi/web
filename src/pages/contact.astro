---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout title="Contact | Marcus Schimizzi" description="Get in touch with Marcus Schimizzi.">
    <div class="page contact">
        <header class="page-header">
            <span class="section-num">Contact</span>
            <h1 class="page-title">Let's <em>talk.</em></h1>
            <p class="page-lead">
                Feel free to fill out the form if there's something you'd like to chat about — or even if you'd just like to say hi. No recruiters or solicitations, please.
            </p>
        </header>

        <div id="success-msg" class="msg msg-success" hidden>
            Thank you for reaching out! I'll follow up to the email you left.
        </div>
        <div id="error-msg" class="msg msg-error" hidden>
            Uh-oh! There was a problem submitting the form. Please try again.
        </div>

        <form name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" id="contact-form" class="contact-form">
            <input type="hidden" name="form-name" value="contact" />
            <p style="display:none"><input name="bot-field" /></p>

            <div class="field">
                <label for="name" class="field-label">Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    autocomplete="name"
                    required
                />
            </div>

            <div class="field">
                <label for="email" class="field-label">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                    required
                />
            </div>

            <div class="field">
                <label for="message" class="field-label">Message</label>
                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                ></textarea>
            </div>

            <button type="submit" class="submit-btn">
                Send message
            </button>
        </form>
    </div>
</PageLayout>

<script>
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
            const formData = new FormData(form);
            const response = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(formData).toString(),
            });
            if (response.ok) {
                form.setAttribute('hidden', '');
                successMsg?.removeAttribute('hidden');
            } else {
                errorMsg?.removeAttribute('hidden');
            }
        } catch {
            errorMsg?.removeAttribute('hidden');
        }
    });
</script>

<style>
    .page {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 0 4rem;
    }
    .page-header {
        padding-bottom: 3rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--rule);
    }
    .section-num {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 1.25rem;
    }
    .page-title {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.035em;
        line-height: 0.95;
        color: var(--ink);
        margin: 0 0 1.5rem;
    }
    .page-title em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        color: var(--gold);
        letter-spacing: -0.015em;
    }
    .page-lead {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        color: var(--ink);
        max-width: 56ch;
        line-height: 1.55;
        margin: 0 0 0.5rem;
    }

    .msg {
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        border: 1px solid var(--rule-strong);
    }
    .msg[hidden] { display: none; }
    .msg-success { color: var(--ink); border-color: var(--gold); background: rgba(230, 181, 74, 0.08); }
    .msg-error   { color: #ff8b8b; border-color: rgba(255, 139, 139, 0.4); background: rgba(255, 139, 139, 0.08); }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }
    .field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .field-label {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
    }
    .field input,
    .field textarea {
        width: 100%;
        background: var(--paper-raised);
        border: 1px solid var(--rule-strong);
        padding: 0.875rem 1rem;
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--ink);
        transition: border-color 0.2s ease;
        border-radius: 0;
    }
    .field textarea { resize: vertical; min-height: 7rem; }
    .field input:focus,
    .field textarea:focus {
        border-color: var(--gold);
    }

    .submit-btn {
        align-self: flex-start;
        margin-top: 0.5rem;
        padding: 0.875rem 1.5rem;
        background: var(--gold);
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: background 0.2s ease, transform 0.2s ease;
    }
    .submit-btn:hover { background: var(--gold-warm); }
</style>
